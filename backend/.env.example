# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
ENVIRONMENT=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=nms_admin
DB_PASSWORD=changeme
DB_NAME=hospital_nms
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=50
DB_MAX_IDLE_CONNECTIONS=10
DB_CONNECTION_MAX_LIFETIME=30m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=change-this-to-a-random-secret
JWT_REFRESH_SECRET=change-this-to-another-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=hospital-nms

# Encryption
ENCRYPTION_KEY=32-byte-hex-encryption-key-here

# SMTP
SMTP_HOST=smtp.hospital.com
SMTP_PORT=587
SMTP_USER=nms-notifications@hospital.com
SMTP_PASSWORD=changeme
SMTP_FROM=nms@hospital.com

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=1m

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
SENTRY_DSN=

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
# Log files (comma separated, patterns allowed) that lose entries older than
# LOG_KEEP_DAYS. Only files named .log are touched. Empty turns the cleanup off.
LOG_KEEP_DAYS=10
LOG_CLEANUP_FILES=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Network Scanning
SCAN_TIMEOUT=30s
SCAN_CONCURRENCY=50
SCAN_DEFAULT_PORTS=22,80,443,8080,3389,8443
PING_TIMEOUT=2s
TRACEROUTE_MAX_HOPS=30

# Router safety (policy engines: Marco groups + legacy policies)
# Nothing is written to the MikroTik unless this is true. While false, every sync
# only computes and logs the plan ("dry-run").
ROUTER_POLICY_WRITES=false
# Keep false. Layer7 took the hospital's internet down on 2026-11-03 and the router
# session now refuses it, so true only makes syncs fail. See docs/ROUTER_SAFETY.md.
ROUTER_ENABLE_LAYER7=false
# Router-wide static DNS blocking (affects every device). Keep off.
ROUTER_ENABLE_DNS_BLOCK=false
# Addresses/CIDRs that policy rules must never target (admin PCs, servers). The router itself is always protected.
ROUTER_PROTECTED_IPS=
# Refuse to apply a plan with more managed router entries than this.
ROUTER_MAX_MANAGED_ENTRIES=1000

# Remove the nms-marco- entries the sync no longer wants (a device taken out of a
# group, an unblocked site, a deleted group) so lifting a block really lifts it.
# Set to false to add and update only. Only entries with the nms-marco- prefix are touched.
ROUTER_PRUNE_STALE=true
# A sync that would remove more entries than this is refused.
ROUTER_MAX_PRUNE=60
# The legacy policy engine stays a dry-run even when ROUTER_POLICY_WRITES=true.
ROUTER_LEGACY_POLICY_WRITES=false
# Block a platform through an address-list that already exists on the router
# instead of built-in IP ranges. Needed for YouTube: its addresses are shared with
# Gmail/Search, so without this it is reported as not enforceable. key=list;key=list
ROUTER_PLATFORM_DST_LISTS=

# Security scans read the router connection table: thousands of rows and seconds of full
# CPU on a small router. They only run when someone presses "Scan now" unless an interval
# is set; they never start while the router is above ROUTER_SCAN_MAX_CPU, and never twice
# within ROUTER_SCAN_COOLDOWN.
ROUTER_SECURITY_SCAN_INTERVAL=0
ROUTER_SCAN_MAX_CPU=85
ROUTER_SCAN_COOLDOWN=5m
# Scan results (destinations only, never page addresses) are deleted after this many days.
SECURITY_RETENTION_DAYS=30
# Router address-lists that name platforms by their addresses: name=list;name=list
ROUTER_SCAN_PLATFORM_LISTS=

# Websites by name (see docs/OPERATIONS.md, "Websites by name"). Nothing is listened on or
# read unless one of these is set. Only domains are stored, per device per hour.
# Pi-hole query log over its API (read only): v6 uses the password, v5 the API token.
PIHOLE_URL=
PIHOLE_PASSWORD=
PIHOLE_API_TOKEN=
PIHOLE_INSECURE_TLS=false
PIHOLE_POLL_INTERVAL=30s
# Query log sent by syslog from any resolver or the router, for example :5514
DNS_SYSLOG_LISTEN=
DNS_SYSLOG_ALLOW=
DNS_RETENTION_DAYS=30
